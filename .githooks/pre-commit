#!/usr/bin/env bash
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass one commit:      git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

command -v cargo >/dev/null || { echo "pre-commit: cargo not found, skipping"; exit 0; }

if ! cargo fmt --all --check >/dev/null 2>&1; then
  cargo fmt --all
  echo "pre-commit: ran cargo fmt; review and re-stage the changes." >&2
  exit 1
fi

exec bash tools/check.sh guardrails
